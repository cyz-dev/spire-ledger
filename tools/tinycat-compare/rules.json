{
  "comment": "Classification of differences between TinyCat 4.5.6 and Spire Ledger. Each rule names explicit TinyCat tables and fields, a direction condition, and a quote that must appear verbatim in the cited document. First matching rule wins. Category a = registered metric decision (metrics.md), b = registered defect.",
  "rules": [
    {"id": "holding_counts_copies", "category": "a",
     "tables": ["cardWinRate"], "fields": ["numerator", "denominator"], "condition": "tinycat_ge_ledger",
     "explain": "TinyCat 按张次计持牌胜率，本项目同名卡每局只计一次，TinyCat 的分子分母不小于本项目",
     "ref": {"doc": "docs/metrics.md", "section": "6.2 B 持牌胜率", "quote": "**TinyCat 按张次计**"}},
    {"id": "pick_duplicate_candidates", "category": "a",
     "tables": ["cardPicksAct1", "cardPicksAct2", "cardPicksAct3_4", "cardPicksAfterAct1"], "fields": ["denominator"], "condition": "tinycat_ge_ledger",
     "explain": "TinyCat 对同屏重复候选逐条计数，提供次数不小于本项目",
     "ref": {"doc": "docs/metrics.md", "section": "6.2 B 卡牌抓率", "quote": "TinyCat 对同屏重复出现的牌逐条计数"}},
    {"id": "skip_bowl_split", "category": "a",
     "tables": ["cardPicksAct1", "cardPicksAct2", "cardPicksAct3_4", "cardPicksAfterAct1"], "match_dims": {"key": ["SKIP", "Singing Bowl"]},
     "fields": ["numerator", "denominator"], "condition": "any",
     "explain": "TinyCat 有歌唱碗时用歌唱碗代替 SKIP 候选；本项目跳过与歌唱碗分开计",
     "ref": {"doc": "docs/metrics.md", "section": "6.2 B 奖励屏数、跳过率、歌唱碗率", "quote": "TinyCat 把歌唱碗并入 SKIP；本项目分开"}},
    {"id": "survival_heart_all_acts", "category": "a",
     "tables": ["survivalRatePerAct"], "fields": ["numerator", "denominator"], "condition": "any",
     "explain": "TinyCat 心脏通关局四幕全记撑过并跳过奖励层；本项目按实际到达的幕",
     "ref": {"doc": "docs/metrics.md", "section": "6.1 B 各幕存活率", "quote": "TinyCat 心脏通关时四幕全记撑过"}},
    {"id": "death_without_floor_match", "category": "a",
     "tables": ["encounterDeadRate"], "fields": ["numerator"], "condition": "any",
     "explain": "TinyCat 按最后一幕和遭遇名记死亡，不比较楼层；本项目要求楼层等于 floor_reached",
     "ref": {"doc": "docs/metrics.md", "section": "6.4 B 遭遇死亡率", "quote": "本项目要求楼层匹配"}},
    {"id": "event_per_occurrence", "category": "a",
     "tables": ["eventWinRateAct1", "eventWinRateAct2", "eventWinRateAct3"], "fields": ["numerator", "denominator"], "condition": "tinycat_ge_ledger",
     "explain": "TinyCat 事件胜率按事件次数计，本项目同一局只计一次",
     "ref": {"doc": "docs/metrics.md", "section": "6.5 B 事件次数、事件胜率", "quote": "**TinyCat 事件胜率按事件次数计**"}},
    {"id": "potions_from_rhp", "category": "a",
     "tables": ["averagePotionUse"], "fields": ["presence"], "condition": "row_only_in_ledger",
     "explain": "TinyCat 只读 RunHistoryPlus potion_use_per_floor（本机为空），本项目读 potions_floor_usage",
     "ref": {"doc": "docs/metrics.md", "section": "6.4 B 药水使用", "quote": "TinyCat 读 RunHistoryPlus `potion_use_per_floor`，每场上限 9"}},
    {"id": "neow_purges_from_log", "category": "a",
     "tables": ["purgesBySource", "neowPurges"], "match_dims": {"key": ["NEOW", null]}, "fields": ["value"], "condition": "tinycat_zero",
     "explain": "TinyCat 尼奥删牌只读 RunHistoryPlus neow_bonus_log（本机为空，恒为 0）",
     "ref": {"doc": "docs/metrics.md", "section": "6.5 B 删牌、升级来源", "quote": "TinyCat 尼奥删牌读 `neow_bonus_log`，本机 0/762"}},
    {"id": "total_purges_without_neow", "category": "a",
     "tables": ["totalCardsPurged", "purgesBySource"], "match_dims": {"key": [null, "ALL"]}, "fields": ["value"], "condition": "tinycat_le_ledger",
     "explain": "总删牌数里 TinyCat 缺尼奥删牌，只会比本项目少",
     "ref": {"doc": "docs/metrics.md", "section": "6.5 B 删牌、升级来源", "quote": "TinyCat 尼奥删牌读 `neow_bonus_log`，本机 0/762"}},
    {"id": "shop_count_from_shop_contents", "category": "a",
     "tables": ["shopActionsTotal", "shopActionsAct1", "shopActionsAct2", "shopActionsAct3", "shopActionsAct4"], "match_dims": {"key": ["商店总数"]},
     "fields": ["denominator", "presence"], "condition": "any",
     "explain": "TinyCat 的商店总数读 RunHistoryPlus shop_contents（本机为空），本项目按路径 $ 计进店次数",
     "ref": {"doc": "docs/metrics.md", "section": "6.5 B 进店次数", "quote": "TinyCat 的“商店总数”读 `shop_contents`（本机为空）"}},
    {"id": "mod_content_runs", "category": "a",
     "tables": ["_runs"], "match_dims": {"reason": ["mod_content_colon"]}, "fields": ["presence"], "condition": "row_only_in_ledger",
     "explain": "TinyCat 整局丢弃含 ':' 模组内容的局，本项目默认保留",
     "ref": {"doc": "docs/metrics.md", "section": "2 样本范围", "quote": "TinyCat 还整局丢弃卡组或遗物里含 `:` 的模组内容局"}},
    {"id": "missing_neow_bonus_runs", "category": "a",
     "tables": ["_runs"], "match_dims": {"reason": ["missing_neow_bonus"]}, "fields": ["presence"], "condition": "row_only_in_ledger",
     "explain": "TinyCat 整局丢弃缺 neow_bonus 的局，本项目保留，只让尼奥指标缺失",
     "ref": {"doc": "docs/metrics.md", "section": "2 样本范围", "quote": "TinyCat 也整局丢弃缺 `neow_bonus` 的局"}},

    {"id": "boss_skip_not_counted", "category": "b",
     "tables": ["bossRelicPickRateAct1", "bossRelicPickRateAct2"], "fields": ["presence", "denominator"], "condition": "tinycat_ge_ledger",
     "explain": "现有实现没有把 Boss 遗物的跳过计为选项（M2 须改）：SKIP 行缺失，其余候选的提供次数偏少",
     "ref": {"doc": "docs/metrics.md", "section": "10 第 6 条", "quote": "Boss 遗物选取率没有把跳过计为选项。"}},
    {"id": "native_card_choices_missing", "category": "b",
     "tables": ["cardPicksAct1", "cardPicksAct2", "cardPicksAct3_4", "cardPicksAfterAct1"], "fields": ["presence"], "condition": "row_only_in_tinycat",
     "explain": "现有实现只用 Ledger 决策计抓率，原版 .run 的 card_choices 未进入（M2 须改）",
     "ref": {"doc": "docs/metrics.md", "section": "10 第 5 条", "quote": "原版局的 `card_choices` 没有进入抓率；只有 Ledger 决策计入。"}}
  ]
}
